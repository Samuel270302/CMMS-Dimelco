{
  "name": "cmms-dimelco",
  "productName": "CMMS Dimelco",
  "version": "0.2.0",
  "description": "CMMS de mantenimiento: preventivo por horómetros, backlog y programación",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "prueba:electron": "npm run build && xvfb-run -a node tests/electron.mjs",
    "build:web": "tsc -b && vite build --mode web",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build --mode demo",
    "reporte:correo:compilar": "esbuild tools/reporte_correo.ts --bundle --platform=node --format=esm --packages=external --loader:.png=dataurl --outfile=tools/dist/reporte_correo.mjs --log-level=warning",
    "reporte:correo": "npm run reporte:correo:compilar && node tools/dist/reporte_correo.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.hemco.cmms",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CMMS-Dimelco-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Samuel270302",
        "repo": "CMMS-Dimelco"
      }
    ]
  }
}
